APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./pipeguard.db
SESSION_SECRET=change-this-to-a-long-random-secret
CSRF_SECRET=change-this-to-a-different-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000
MODEL_PATH=../model_artifacts/approved_model.joblib
MODEL_MANIFEST_PATH=../model_artifacts/artifact_manifest.json
ENABLE_DEMO_MODE=true
ENABLE_TECHNICIAN_LOGIN=true
MAX_CSV_BYTES=4000000
LOG_LEVEL=INFO
NEXT_PUBLIC_APP_NAME=PipeGuard AI
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_THEME=system
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
DEMO_TECHNICIAN_EMAIL=technician@pipeguard.local
DEMO_TECHNICIAN_PASSWORD=change-before-use
NEXT_PUBLIC_ENABLE_GLOBAL_PIPELINE_SEARCH=true
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GLOBAL_PIPELINE_MAX_RESULTS=1000
GLOBAL_PIPELINE_MAX_LATITUDE_SPAN=2.0
GLOBAL_PIPELINE_MAX_LONGITUDE_SPAN=2.0
GEOCODER_CACHE_SECONDS=86400
PIPELINE_CACHE_SECONDS=1800

